---
import SignalPath from "./SignalPath";
import { Button } from "@/components/ui/button";
---

<section class="bg-signal-glow relative border-b border-white/10">
	<div class="relative mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2 md:items-center md:py-32">
		<div>
			<p class="font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
				Live-streaming engine
			</p>
			<h1 class="mt-4 text-4xl leading-[1.1] font-semibold text-balance text-foreground md:text-5xl">
				The streaming engine behind your product, not another platform to log into.
			</h1>
			<p class="mt-6 max-w-md text-lg text-muted-foreground">
				RTMP and WHIP in, HLS, LL-HLS, and WHEP out. Elixir/OTP keeps one channel's
				crash from taking down the rest. Run it yourself or let us run the media
				plane for you.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<Button asChild size="lg">
					<a href="/docs/quickstart-self-host">Read the quickstart</a>
				</Button>
				<Button asChild size="lg" variant="outline">
					<a href="/#offerings">See offerings</a>
				</Button>
			</div>
			<p class="mt-6 font-mono text-xs text-muted-foreground">v0.1.0 · pre-1.0, actively built</p>
		</div>
		<SignalPath client:load />
	</div>
</section>
