---
import { AudioWaveform, ListChecks } from "lucide-react";
import { siElixir, siPhoenixframework, siGo, siPostgresql } from "simple-icons";
import BrandIcon from "./BrandIcon.astro";

const stack = [
	{
		name: "Elixir 1.17 / OTP 26",
		brand: siElixir.path,
		role: "Per-channel process isolation — one crashed pipeline never touches another live stream.",
		span: "sm:col-span-2",
		big: true,
	},
	{
		name: "Phoenix",
		brand: siPhoenixframework.path,
		role: "The control-plane REST API — organizations, channels, keys, webhooks, usage.",
		span: "",
	},
	{
		name: "Membrane Framework",
		icon: AudioWaveform,
		role: "RTMP ingest and ABR transcode, with real LL-HLS packaging.",
		span: "",
	},
	{
		name: "Go 1.26 + Pion",
		brand: siGo.path,
		role: "WHIP and WHEP over WebRTC — the same library underlying most production SFUs.",
		span: "",
	},
	{
		name: "PostgreSQL",
		brand: siPostgresql.path,
		role: "The only stateful store. No Redis — Oban runs durable jobs straight off it.",
		span: "",
	},
	{
		name: "Oban",
		icon: ListChecks,
		role: "Webhook delivery, usage rollups, and license heartbeats, all retried and durable.",
		span: "sm:col-span-2 lg:col-span-3",
	},
];
---

<section class="border-b border-border">
	<div class="mx-auto max-w-4xl px-6 py-20">
		<h2 class="text-2xl font-semibold text-foreground md:text-3xl">Built with, not built on top of.</h2>
		<p class="mt-3 max-w-2xl text-muted-foreground">
			Every piece here is load-bearing — nothing on this list is decoration.
		</p>
		<div class="reveal-scale-in mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
			{stack.map((item) => (
				<div class:list={["card-hover rounded-lg border border-border bg-card/40 p-6", item.span]}>
					<div class="flex items-center gap-2.5">
						<span class:list={["flex shrink-0 items-center justify-center rounded-md border border-border text-primary", item.big ? "h-10 w-10" : "h-8 w-8"]}>
							{item.brand ? (
								<BrandIcon path={item.brand} class={item.big ? "h-5 w-5" : "h-4 w-4"} />
							) : (
								<item.icon className={item.big ? "h-5 w-5" : "h-4 w-4"} />
							)}
						</span>
						<span class:list={["font-mono text-foreground", item.big ? "text-base" : "text-sm"]}>{item.name}</span>
					</div>
					<p class:list={["mt-3 text-muted-foreground", item.big ? "text-sm" : "text-sm"]}>{item.role}</p>
				</div>
			))}
		</div>
	</div>
</section>
