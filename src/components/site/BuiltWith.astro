---
const stack = [
	"Elixir 1.17 / OTP 26",
	"Phoenix",
	"Membrane Framework",
	"Go 1.26 + Pion",
	"PostgreSQL",
	"Oban",
];
---

<section class="border-b border-white/10">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<p class="text-center font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
			Built with
		</p>
		<div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 font-mono text-sm text-muted-foreground">
			{stack.map((item) => <span>{item}</span>)}
		</div>
	</div>
</section>
