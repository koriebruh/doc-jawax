---
import { AudioWaveform, ListChecks } from "lucide-react";
import { siElixir, siPhoenixframework, siGo, siPostgresql } from "simple-icons";
import BrandIcon from "./BrandIcon.astro";

const stack = [
	{ name: "Elixir 1.17 / OTP 26", brand: siElixir.path, role: "Per-channel process isolation — one crashed pipeline never touches another live stream." },
	{ name: "Phoenix", brand: siPhoenixframework.path, role: "The control-plane REST API — organizations, channels, keys, webhooks, usage." },
	{ name: "Membrane Framework", icon: AudioWaveform, role: "RTMP ingest and ABR transcode, with real LL-HLS packaging." },
	{ name: "Go 1.26 + Pion", brand: siGo.path, role: "WHIP and WHEP over WebRTC — the same library underlying most production SFUs." },
	{ name: "PostgreSQL", brand: siPostgresql.path, role: "The only stateful store. No Redis — Oban runs durable jobs straight off it." },
	{ name: "Oban", icon: ListChecks, role: "Webhook delivery, usage rollups, and license heartbeats, all retried and durable." },
];
---

<section class="border-b border-border">
	<div class="mx-auto max-w-4xl px-6 py-20">
		<h2 class="text-2xl font-semibold text-foreground md:text-3xl">Built with, not built on top of.</h2>
		<p class="mt-3 max-w-2xl text-muted-foreground">
			Every piece here is load-bearing — nothing on this list is decoration.
		</p>
		<div class="reveal-cascade-left mt-10 divide-y divide-border border-y border-border" data-reveal>
			{stack.map((item) => (
				<div class="flex flex-col gap-2 py-5 sm:flex-row sm:items-center sm:gap-8">
					<div class="flex items-center gap-3 sm:w-64 sm:shrink-0">
						<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border text-primary">
							{item.brand ? <BrandIcon path={item.brand} class="h-4 w-4" /> : <item.icon className="h-4 w-4" />}
						</span>
						<span class="font-mono text-sm text-foreground">{item.name}</span>
					</div>
					<p class="text-sm text-muted-foreground sm:flex-1">{item.role}</p>
				</div>
			))}
		</div>
	</div>
</section>
