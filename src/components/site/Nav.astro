---
import { buttonVariants } from "@/components/ui/button";
import MobileNav from "./MobileNav";
---

<header class="sticky top-0 z-50 border-b border-transparent bg-background/80 backdrop-blur-md [border-image:linear-gradient(to_right,transparent,var(--color-primary)_35%,var(--color-delivery)_65%,transparent)_1]">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
		<a href="/" class="flex items-center gap-2 font-mono text-sm text-foreground">
			<img src="/logo.svg" alt="" width="24" height="24" class="h-6 w-6 rounded-md" />
			jawax
		</a>
		<nav class="hidden items-center gap-8 text-sm text-muted-foreground md:flex">
			<a href="/#not-a-platform" class="transition-colors hover:text-foreground">Product</a>
			<a href="/#offerings" class="transition-colors hover:text-foreground">Offerings</a>
			<a href="/docs" class="transition-colors hover:text-foreground">Docs</a>
			<a href="/#faq" class="transition-colors hover:text-foreground">FAQ</a>
		</nav>
		<div class="flex items-center gap-2">
			<a
				href="/docs/quickstart-self-host"
				class:list={[buttonVariants({ variant: "ghost", size: "sm" }), "hidden sm:inline-flex"]}
			>
				Quickstart
			</a>
			<a href="/#offerings" class:list={[buttonVariants({ size: "sm" }), "hidden sm:inline-flex"]}>
				Talk to us
			</a>
			<MobileNav client:load />
		</div>
	</div>
</header>
