---
const year = new Date().getFullYear();

const columns = [
	{
		title: "Product",
		links: [
			{ href: "/#not-a-platform", label: "Product" },
			{ href: "/#offerings", label: "Offerings" },
			{ href: "/#faq", label: "FAQ" },
		],
	},
	{
		title: "Docs",
		links: [
			{ href: "/docs", label: "Overview" },
			{ href: "/docs/quickstart-self-host", label: "Quickstart — self-host" },
			{ href: "/docs/quickstart-cloud", label: "Quickstart — cloud" },
			{ href: "/docs/api-reference", label: "API reference" },
			{ href: "/docs/architecture", label: "Architecture" },
		],
	},
	{
		title: "Contact",
		links: [{ href: "mailto:hello@jawax.io", label: "hello@jawax.io" }],
	},
];
---

<footer class="relative border-t border-transparent [border-image:linear-gradient(to_right,transparent,var(--color-primary)_35%,var(--color-delivery)_65%,transparent)_1]">
	<div class="mx-auto max-w-6xl px-6 py-16">
		<div class="grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr_1fr]">
			<div>
				<a href="/" class="flex items-center gap-2 font-mono text-sm text-foreground">
					<img src="/logo.png" alt="" width="24" height="24" class="h-6 w-6 rounded-md" />
					jawax
				</a>
				<p class="mt-3 max-w-xs text-sm text-muted-foreground">
					A live-streaming engine you embed into your own product. Self-host it,
					or let us run the media plane for you.
				</p>
				<p class="mt-4 font-mono text-xs text-muted-foreground">v0.1.0 · pre-1.0, actively built</p>
			</div>
			{columns.map((col) => (
				<div>
					<p class="font-mono text-xs tracking-[0.15em] text-muted-foreground uppercase">{col.title}</p>
					<ul class="mt-3 space-y-2 text-sm">
						{col.links.map((link) => (
							<li>
								<a href={link.href} class="text-muted-foreground transition-colors hover:text-foreground">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
		<div class="mt-12 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} Jawax. Self-host under AGPL-3.0.</p>
			<p>Elixir/OTP · Phoenix · Membrane · Go + Pion · PostgreSQL</p>
		</div>
	</div>
</footer>
